{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/spec_eval_gate.py track",
            "timeout": 10,
            "statusMessage": "Tracking touched spec folders"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/spec_eval_gate.py claude-stop",
            "timeout": 120,
            "statusMessage": "Running .claude/.skills/spec-eval"
          }
        ]
      }
    ]
  }
}
